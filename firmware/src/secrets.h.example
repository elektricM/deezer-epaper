// Copy to secrets.h and fill in. secrets.h is yours; do not share it.
#pragma once

#define WIFI_SSID "your-network"
#define WIFI_PASS "your-password"

// Where the panel fetches its frame. Point this at the Mac running
//   python3 tools/nowplaying.py --bind 0.0.0.0
// Use the IP rather than a .local name if resolution is flaky.
#define FRAME_URL "http://192.168.1.174:8766/frame.bin"

// How long the server may hold an idle request open, in seconds. The panel
// reconnects immediately afterwards, so idle traffic is a handful of bytes a
// minute. Keep it under your router's idle-connection timeout.
#define LONG_POLL_SECONDS 50
